# Spotdrop Server Configuration

# Port for production server (default: 3000)
PORT=3000

# Admin Dashboard Password (used to log in at /admin)
# Change this to a strong secret in production!
ADMIN_PASSWORD=spotdrop_admin_2026

# Session Secret for secure cookie signing
SESSION_SECRET=spotdrop_secure_session_secret_change_in_production_2026

# Optional: SQLite Database Path (used for local development)
DATABASE_PATH=./data/spotdrop.db

# ===================================================================
# OPTIONAL: SUPABASE PERSISTENCE (RECOMMENDED FOR VERCEL SERVERLESS)
# If provided in Vercel Environment Variables, Spotdrop automatically
# uses Supabase Postgres for durable storage across serverless instances.
# If omitted, Spotdrop falls back gracefully to local storage.
# ===================================================================
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_KEY=your-supabase-service-role-or-anon-key
